# Default endpoint that receives {id, domain, text} (a request may send callback_url instead)
API_ENDPOINT=https://api.controleonline.com/transcriptions
# Shared secret: sent as X-Whisper-Token on callbacks (API side: WHISPER_TOKEN)
API_TOKEN=change-me
# Shared secret required on POST /transcrip (header X-Whisper-Token)
WHISPER_TOKEN=change-me
WHISPER_MODEL=base
WHISPER_LANGUAGE=pt
# Seconds without work before the model is released from memory
WHISPER_IDLE_UNLOAD=120
MAX_UPLOAD_MB=25
HOST=127.0.0.1
PORT=8090
# Hosts allowed as callback_url (https only)
CALLBACK_HOSTS=api.controleonline.com,dd.controleonline.com,s.controleonline.com
